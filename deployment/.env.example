# Required
OPENAI_API_KEY=replace-me
DATABASE_URL=postgresql://readonly-user:password@database-host:5432/database-name
CHARTS_API_BASE_URL=https://charts-api.gpisurveys.com
CHARTS_STATS_EXTERNAL_ACCESS_SECRET=replace-me
# Generate the production value with: openssl rand -hex 32
HERBALIFE_EXTERNAL_ACCESS_SECRET=replace-with-at-least-32-random-characters

# Models and runtime tuning
MODEL_NAME=gpt-5.5
MODEL_REASONING_EFFORT=low
# STRONG_MODEL_NAME and STRONG_REASONING_EFFORT remain temporary migration fallbacks.
OPENAI_VERBOSITY=
# Leave empty for backend-to-backend calls. Set exact UI origins only if a browser calls this API.
CORS_ORIGINS=
HISTORY_MAX_ROUNDS=5
HISTORY_MAX_MESSAGES=47
# Caps homogeneous SQL or statistics batches. If omitted, MAX_PARALLEL_SQL_CALLS is used.
MAX_PARALLEL_TOOL_CALLS=6
MAX_PARALLEL_SQL_CALLS=6
DB_CONNECT_TIMEOUT_S=10
LEDGER_MAX_CHARS=4000
INVENTORY_MAX_CHARS=120000
PERSONA_INVENTORY_MAX_CHARS=120000
INVENTORY_CACHE_ACTIVE_TTL_S=300
INVENTORY_CACHE_CLOSED_TTL_S=86400
INVENTORY_CACHE_BENCHMARK_TTL_S=86400
INVENTORY_CACHE_MAX_ENTRIES=128
